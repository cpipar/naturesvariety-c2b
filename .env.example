# ─────────────────────────────────────────────────────────────────────────────
# Connexion au Google Sheet  (obligatoire)
# ─────────────────────────────────────────────────────────────────────────────

# Clé du compte de service Google, JSON complet sur UNE seule ligne.
# Console Google Cloud → IAM & Admin → Service Accounts → Keys → Add key (JSON).
# Puis partager le Google Sheet en lecture avec le client_email de cette clé.
# La valeur est aussi acceptée en base64, si l'interface d'hébergement abîme
# les retours à la ligne :  base64 -i cle.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON="{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"dashboard@mon-projet.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}"

# Identifiant du Sheet : la chaîne entre /d/ et /edit dans son URL.
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Options de lecture
# ─────────────────────────────────────────────────────────────────────────────

# Nom exact de l'onglet à lire. Vide = premier onglet du document.
GOOGLE_SHEET_TAB=

# Durée du cache en secondes avant relecture du Sheet. Défaut 900 (15 min).
REVALIDATE_SECONDS=900

# ─────────────────────────────────────────────────────────────────────────────
# Habillage et accès
# ─────────────────────────────────────────────────────────────────────────────

CLIENT_NAME="Nature's Variety"
CAMPAIGN_NAME="Grain-free range campaign · France"
CLIENT_LOGO=

# Mot de passe d'accès au dashboard. Vide = accès libre.
DASHBOARD_PASSWORD=
